{
  "include": [
    "src/**/*"
  ],
  "compilerOptions": {
    "target": "es2015", // 想定動作環境：とりあえず最新とする

    // JS関係
    "allowJs": true, // JSファイルを読み込み対象とするように指定
    "checkJs": true, // JSファイルも型チェック対象とする

    // 型定義関係
    "declaration": true, // 型定義（d.ts）ファイルを出力
    "emitDeclarationOnly": true, // 型定義ファイルの出力だけを行う
    "declarationDir": "./types", // 型定義ファイルの出力先

    // TSルール
    "strict": true
  },
}
